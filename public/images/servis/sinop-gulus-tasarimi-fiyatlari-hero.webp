 
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 Sayfa Bulunamadı | AvrupaDiş Diş Hastanesi ve Diş Kliniği</title>
  <meta name="robots" content="noindex, follow" />
  <meta name="description" content="Aradığınız sayfa bulunamadı. AvrupaDİŞ ana sayfasına dönebilir, tedavilerimizi inceleyebilir veya bizimle iletişime geçebilirsiniz." />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <style>
    :root{
      --primary: #0f5fa8;
      --primary-dark: #0a4b84;
      --accent: #1ec4d6;
      --text: #17324a;
      --muted: #6b7f92;
      --bg: #f3f8fc;
      --card: #ffffff;
      --border: #e2edf6;
      --shadow: 0 12px 35px rgba(15,95,168,0.10);
      --radius: 20px;
    }

    *{ box-sizing: border-box; }
    html, body{ margin:0; padding:0; }
    body{
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at 10% 10%, rgba(30,196,214,0.12), transparent 40%),
        radial-gradient(circle at 90% 20%, rgba(15,95,168,0.12), transparent 38%),
        linear-gradient(180deg, #f7fbff 0%, var(--bg) 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .topbar{
      width: 100%;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(226,237,246,0.85);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .topbar-inner{
      max-width: 1200px;
      margin: 0 auto;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .brand{
      display: inline-flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .brand img{
      height: 42px;
      width: auto;
      display: block;
    }

    .brand small{
      display:block;
      color: var(--muted);
      font-size: 12px;
      margin-top: 2px;
    }

    .header-actions{
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .chip{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: #fff;
      color: var(--text);
      text-decoration: none;
      font-size: 14px;
      transition: .2s ease;
    }

    .chip:hover{
      border-color: rgba(15,95,168,.35);
      box-shadow: 0 6px 16px rgba(15,95,168,.08);
      transform: translateY(-1px);
    }

    .wrap{
      width: 100%;
      max-width: 1200px;
      margin: auto;
      padding: 28px 18px 36px;
    }

    .grid{
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 22px;
    }

    .card{
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .hero{
      padding: 30px;
      position: relative;
      overflow: hidden;
    }

    .hero::before{
      content:"";
      position:absolute;
      width: 280px;
      height: 280px;
      right: -90px;
      top: -80px;
      background: radial-gradient(circle, rgba(30,196,214,0.20), rgba(30,196,214,0));
      border-radius: 50%;
      pointer-events: none;
    }

    .hero::after{
      content:"";
      position:absolute;
      width: 220px;
      height: 220px;
      left: -60px;
      bottom: -80px;
      background: radial-gradient(circle, rgba(15,95,168,0.15), rgba(15,95,168,0));
      border-radius: 50%;
      pointer-events: none;
    }

    .status{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(15,95,168,.08);
      color: var(--primary-dark);
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 16px;
    }

    .status-dot{
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 5px rgba(30,196,214,.15);
    }

    .code404{
      font-size: clamp(52px, 9vw, 110px);
      line-height: .95;
      margin: 0 0 10px;
      font-weight: 800;
      letter-spacing: -1px;
      color: var(--primary);
    }

    h1{
      margin: 0 0 12px;
      font-size: clamp(22px, 3vw, 36px);
      line-height: 1.15;
      letter-spacing: -.2px;
    }

    .lead{
      margin: 0 0 18px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.6;
      max-width: 62ch;
    }

    .countdown-box{
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      background: #f8fbfe;
      border: 1px dashed #cfe3f4;
      border-radius: 14px;
      padding: 12px 14px;
      margin-bottom: 18px;
    }

    .countdown-pill{
      min-width: 44px;
      height: 44px;
      border-radius: 12px;
      background: linear-gradient(180deg, var(--primary), var(--primary-dark));
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 18px;
      box-shadow: 0 8px 20px rgba(15,95,168,.18);
    }

    .countdown-text{
      color: var(--text);
      font-size: 14px;
      line-height: 1.5;
    }

    .countdown-text strong{ color: var(--primary-dark); }

    .btn-row{
      display:flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 8px 0 4px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      text-decoration:none;
      padding: 12px 16px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 14px;
      transition: .2s ease;
      border: 1px solid transparent;
    }

    .btn-primary{
      background: linear-gradient(180deg, var(--primary), var(--primary-dark));
      color:#fff;
      box-shadow: 0 10px 22px rgba(15,95,168,.18);
    }
    .btn-primary:hover{ transform: translateY(-1px); }

    .btn-soft{
      background:#fff;
      color: var(--primary-dark);
      border-color: #cfe3f4;
    }
    .btn-soft:hover{
      border-color: rgba(15,95,168,.35);
      box-shadow: 0 6px 16px rgba(15,95,168,.08);
      transform: translateY(-1px);
    }

    .side{
      padding: 22px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .panel{
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      background: #fff;
    }

    .panel h2{
      margin: 0 0 10px;
      font-size: 16px;
      color: var(--primary-dark);
    }

    .quick-links{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .quick-links a{
      text-decoration:none;
      color: var(--text);
      background:#f9fcff;
      border:1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      font-weight: 600;
      font-size: 14px;
      transition: .2s ease;
    }

    .quick-links a span{
      display:block;
      color: var(--muted);
      font-weight: 500;
      font-size: 12px;
      margin-top: 4px;
    }

    .quick-links a:hover{
      background:#fff;
      border-color: rgba(15,95,168,.35);
      box-shadow: 0 6px 16px rgba(15,95,168,.08);
      transform: translateY(-1px);
    }

    .contact-list{
      display: grid;
      gap: 10px;
    }

    .contact-item{
      display: flex;
      align-items: flex-start;
      gap: 10px;
      text-decoration: none;
      color: var(--text);
      border: 1px solid var(--border);
      background: #fbfdff;
      border-radius: 12px;
      padding: 12px;
      transition: .2s ease;
    }

    .contact-item:hover{
      border-color: rgba(15,95,168,.35);
      box-shadow: 0 6px 16px rgba(15,95,168,.08);
      transform: translateY(-1px);
      background: #fff;
    }

    .icon{
      width: 34px;
      height: 34px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: rgba(15,95,168,.08);
      color: var(--primary-dark);
      flex: 0 0 34px;
    }

    .contact-text strong{
      display:block;
      font-size: 14px;
      margin-bottom: 2px;
    }
    .contact-text small{
      color: var(--muted);
      font-size: 12px;
      line-height: 1.4;
    }

    .socials{
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .socials a{
      width: 42px;
      height: 42px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #fff;
      color: var(--primary-dark);
      display: grid;
      place-items: center;
      text-decoration: none;
      transition: .2s ease;
    }

    .socials a:hover{
      transform: translateY(-2px);
      border-color: rgba(15,95,168,.35);
      box-shadow: 0 8px 20px rgba(15,95,168,.10);
    }

    .footer-note{
      margin-top: 18px;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
    }

    .footer-note a{
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }

    @media (max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
      .hero{ padding: 24px; }
      .quick-links{ grid-template-columns: 1fr; }
    }

    @media (max-width: 560px){
      .topbar-inner{
        justify-content: center;
        text-align: center;
      }
      .header-actions{
        justify-content: center;
      }
      .brand{
        justify-content: center;
        width: 100%;
      }
      .btn-row .btn{
        width: 100%;
      }
      .countdown-box{
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>

  <!-- PHP kullanıyorsanız en üste ekleyin:
    -->

  <header class="topbar" aria-label="Üst bilgi">
    <div class="topbar-inner">
      <a class="brand" href="https://www.avrupadis.com/" aria-label="AvrupaDİŞ Ana Sayfa">
        <img src="https://projeweb.site/avrupadisback/app/Images/logodark_1764936320.svg" alt="AvrupaDİŞ Logo" />
        <div>
          <strong>AvrupaDİŞ</strong>
          <small>Türkiye’nin Gülümseten Kliniği</small>
        </div>
      </a>

      <div class="header-actions">
        <a class="chip" href="tel:4442280" aria-label="Telefonla ara">📞 444 2 280</a>
        <a class="chip" href="https://wa.me/905319378959" target="_blank" rel="noopener" aria-label="WhatsApp">💬 WhatsApp</a>
        <a class="chip" href="/cdn-cgi/l/email-protection#d2bbbcb4bd92b3a4a0a7a2b3b6bba1fcb1bdbf" aria-label="E-posta gönder">✉️ <span class="__cf_email__" data-cfemail="c2abaca4ad82a3b4b0b7b2a3a6abb1eca1adaf">[email&#160;protected]</span></a>
      </div>
    </div>
  </header>

  <main class="wrap" id="main-content">
    <section class="grid" aria-label="404 içerik alanı">
      <!-- Sol içerik -->
      <div class="card hero">
        <div class="status" aria-label="Durum bilgisi">
          <span class="status-dot" aria-hidden="true"></span>
          Sayfa bulunamadı
        </div>

        <div class="code404" aria-hidden="true">404</div>

        <h1>Aradığınız sayfaya şu anda ulaşılamıyor.</h1>

        <p class="lead">
          Bağlantı değişmiş, kaldırılmış ya da adres hatalı yazılmış olabilir.
          Endişe etmeyin — AvrupaDİŞ’in ana sayfasına dönebilir, tedavilerimizi inceleyebilir
          veya doğrudan bizimle iletişime geçebilirsiniz.
        </p>

        <div class="countdown-box" role="status" aria-live="polite">
          <div class="countdown-pill" id="countdown">20</div>
          <div class="countdown-text">
            <strong>20 saniye sonra anasayfaya yönlendirileceksiniz.</strong><br>
            İsterseniz aşağıdaki butonlarla hemen devam edebilirsiniz.
          </div>
        </div>

        <div class="btn-row">
          <a class="btn btn-primary" href="https://www.avrupadis.com/">🏠 Ana Sayfaya Dön</a>
          <a class="btn btn-soft" href="https://www.avrupadis.com/tr/tedavilerimiz">🦷 Tedavilerimiz</a>
          <a class="btn btn-soft" href="https://www.avrupadis.com/tr/iletisim">📍 İletişim</a>
          <a class="btn btn-soft" href="https://wa.me/905319378959" target="_blank" rel="noopener">💬 WhatsApp Randevu</a>
        </div>
      </div>

      <!-- Sağ panel -->
      <aside class="card side" aria-label="Hızlı erişim ve iletişim">
        <div class="panel">
          <h2>Hızlı Erişim</h2>
          <div class="quick-links">
            <a href="https://www.avrupadis.com/">
              Ana Sayfa
              <span>Siteye başlangıç sayfasından devam edin</span>
            </a>
            <a href="https://www.avrupadis.com/tr/hakkimizda">
              Hakkımızda
              <span>Kurumsal yapı ve AvrupaDİŞ hakkında bilgi</span>
            </a>
            <a href="https://www.avrupadis.com/tr/kliniklerimiz">
              Kliniklerimiz
              <span>Size en yakın şubeyi bulun</span>
            </a>
            <a href="https://www.avrupadis.com/tr/hekimlerimiz">
              Hekimlerimiz
              <span>Uzman kadroyu inceleyin</span>
            </a>
          </div>
        </div>

        <div class="panel">
          <h2>Bizimle İletişime Geçin</h2>
          <div class="contact-list">
            <a class="contact-item" href="tel:4442280">
              <div class="icon" aria-hidden="true">📞</div>
              <div class="contact-text">
                <strong>Telefon</strong>
                <small>444 2 280</small>
              </div>
            </a>

            <a class="contact-item" href="https://wa.me/905319378959" target="_blank" rel="noopener">
              <div class="icon" aria-hidden="true">💬</div>
              <div class="contact-text">
                <strong>WhatsApp</strong>
                <small>Hızlı bilgi ve yönlendirme için bize yazın</small>
              </div>
            </a>

            <a class="contact-item" href="/cdn-cgi/l/email-protection#355c5b535a75544347404554515c461b565a58">
              <div class="icon" aria-hidden="true">✉️</div>
              <div class="contact-text">
                <strong>E-posta</strong>
                <small><span class="__cf_email__" data-cfemail="650c0b030a25041317101504010c164b060a08">[email&#160;protected]</span></small>
              </div>
            </a>
          </div>
        </div>

        <div class="panel">
          <h2>Sosyal Medya</h2>
          <div class="socials">
            <a href="https://www.facebook.com/avrupadis/" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">
              <!-- Facebook -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.3V10H7v3h2.5v8h4z"/>
              </svg>
            </a>
            <a href="https://www.instagram.com/avrupadis/" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
              <!-- Instagram -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="1"></circle>
              </svg>
            </a>
            <a href="https://x.com/AvrupaDis" target="_blank" rel="noopener" aria-label="X" title="X">
              <!-- X -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.9 2H22l-6.8 7.8L23 22h-6.3l-5-6.6L6 22H2.9l7.3-8.3L1 2h6.5l4.5 6 5-6zM17.6 20h1.8L6.5 3.9H4.6L17.6 20z"/>
              </svg>
            </a>
            <a href="https://www.youtube.com/channel/UCIxjb6-MAfugkVjf27M3WJQ" target="_blank" rel="noopener" aria-label="YouTube" title="YouTube">
              <!-- YouTube -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L16 12l-6.4 3.6z"/>
              </svg>
            </a>
            <a href="https://www.linkedin.com/company/avrupadis/" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
              <!-- LinkedIn -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5A2.49 2.49 0 0 0 2.5 6c0 1.38 1.11 2.5 2.48 2.5h.02A2.5 2.5 0 1 0 4.98 3.5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-.9 1.8-2.2 3.8-2.2 4 0 4.7 2.6 4.7 6V21h-4v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21H9z"/>
              </svg>
            </a>
            <a href="https://www.tiktok.com/@avrupadis" target="_blank" rel="noopener" aria-label="TikTok" title="TikTok">
              <!-- TikTok -->
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16.5 3c.3 2 1.5 3.2 3.5 3.4v3a6.5 6.5 0 0 1-3.5-1.1V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 1.9 2.8V3h3.1z"/>
              </svg>
            </a>
          </div>
        </div>
      </aside>
    </section>

    <p class="footer-note">
      Sayfa otomatik olarak yönlendirilmezse, <a href="https://www.avrupadis.com/">buraya tıklayarak ana sayfaya dönebilirsiniz</a>.
    </p>
  </main>

  <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
    (function () {
      var seconds = 20;
      var countdownEl = document.getElementById('countdown');
      var targetUrl = 'https://www.avrupadis.com/';
      var redirected = false;

      function updateCountdown() {
        if (countdownEl) {
          countdownEl.textContent = seconds;
        }
      }

      updateCountdown();

      var timer = setInterval(function () {
        seconds--;
        updateCountdown();

        if (seconds <= 0 && !redirected) {
          redirected = true;
          clearInterval(timer);
          window.location.href = targetUrl;
        }
      }, 2000);
    })();
  </script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496" integrity="sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ==" data-cf-beacon='{"version":"2024.11.0","token":"455e19184407469abf6dfc8686e030e1","r":1}' crossorigin="anonymous"></script>
</body>
